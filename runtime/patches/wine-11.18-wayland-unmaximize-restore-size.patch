 #include "config.h"
 
 #include <assert.h>
+#include <pthread.h>
 #include <stdlib.h>
 #include <unistd.h>
 
@@ -263,6 +264,114 @@
  *
  * Destroys a wayland surface.
  */
+/* A sync sent just before a request to be maximized. Its done event arrives,
+ * in order with the configure events, after every configure the compositor
+ * sent before it saw the request. The callback lives on a queue of its own
+ * that only wayland_surface_maximize_pending dispatches, from a configure
+ * handler, so the result is known exactly when a configure is handled. A
+ * surface that goes away first leaves the sync to its done handler. */
+struct wayland_maximize_sync
+{
+    struct wl_callback *callback;
+    BOOL done, orphaned;
+};
+
+static pthread_mutex_t maximize_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_once_t maximize_once = PTHREAD_ONCE_INIT;
+static struct wl_event_queue *maximize_queue;
+
+static void maximize_queue_init(void)
+{
+    maximize_queue = wl_display_create_queue(process_wayland.wl_display);
+}
+
+static void maximize_sync_free(struct wayland_maximize_sync *sync)
+{
+    wl_callback_destroy(sync->callback);
+    free(sync);
+}
+
+static void maximize_sync_done(void *data, struct wl_callback *callback, uint32_t time)
+{
+    struct wayland_maximize_sync *sync = data;
+
+    pthread_mutex_lock(&maximize_mutex);
+    sync->done = TRUE;
+    if (sync->orphaned) maximize_sync_free(sync);
+    pthread_mutex_unlock(&maximize_mutex);
+}
+
+static const struct wl_callback_listener maximize_sync_listener =
+{
+    maximize_sync_done
+};
+
+static void wayland_surface_release_maximize_sync(struct wayland_surface *surface)
+{
+    struct wayland_maximize_sync *sync = surface->maximize_sync;
+
+    if (!sync) return;
+    surface->maximize_sync = NULL;
+    pthread_mutex_lock(&maximize_mutex);
+    if (sync->done) maximize_sync_free(sync);
+    else sync->orphaned = TRUE;
+    pthread_mutex_unlock(&maximize_mutex);
+}
+
+/**********************************************************************
+ *          wayland_surface_sync_maximize
+ *
+ * Mark the configures the compositor sends before it receives the request
+ * to be maximized that the caller sends next. Called with the window data
+ * lock held; a sync still unanswered serves a repeated request.
+ */
+void wayland_surface_sync_maximize(struct wayland_surface *surface)
+{
+    struct wayland_maximize_sync *sync;
+    struct wl_display *wrapper;
+
+    if (surface->maximize_sync) return;
+    pthread_once(&maximize_once, maximize_queue_init);
+    if (!maximize_queue || !(sync = calloc(1, sizeof(*sync)))) return;
+    if (!(wrapper = wl_proxy_create_wrapper(process_wayland.wl_display)))
+    {
+        free(sync);
+        return;
+    }
+    wl_proxy_set_queue((struct wl_proxy *)wrapper, maximize_queue);
+    sync->callback = wl_display_sync(wrapper);
+    wl_proxy_wrapper_destroy(wrapper);
+    if (!sync->callback)
+    {
+        free(sync);
+        return;
+    }
+    /* Only wayland_surface_maximize_pending dispatches this queue, with the
+     * window data lock held, as it is here: no event can precede the listener. */
+    wl_callback_add_listener(sync->callback, &maximize_sync_listener, sync);
+    surface->maximize_sync = sync;
+}
+
+/**********************************************************************
+ *          wayland_surface_maximize_pending
+ *
+ * Whether the configure being handled was sent before the compositor saw
+ * the last request to be maximized. Called with the window data lock held,
+ * from a configure handler.
+ */
+BOOL wayland_surface_maximize_pending(struct wayland_surface *surface)
+{
+    BOOL done;
+
+    if (!surface->maximize_sync) return FALSE;
+    wl_display_dispatch_queue_pending(process_wayland.wl_display, maximize_queue);
+    pthread_mutex_lock(&maximize_mutex);
+    done = surface->maximize_sync->done;
+    pthread_mutex_unlock(&maximize_mutex);
+    if (done) wayland_surface_release_maximize_sync(surface);
+    return !done;
+}
+
 void wayland_surface_destroy(struct wayland_surface *surface)
 {
     pthread_mutex_lock(&process_wayland.pointer.mutex);
@@ -494,6 +603,7 @@
 
     memset(&surface->pending, 0, sizeof(surface->pending));
     surface->pending_toplevel = FALSE;
